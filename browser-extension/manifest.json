{
  "manifest_version": 3,
  "name": "新加坡专线 · 分身代理",
  "version": "1.0.0",
  "description": "独立新加坡节点，全站网页代理；断开时锁住网页网络。",
  "key": "",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "新加坡专线"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lockdown",
        "enabled": true,
        "path": "lockdown.json"
      }
    ]
  },
  "incognito": "not_allowed"
}
